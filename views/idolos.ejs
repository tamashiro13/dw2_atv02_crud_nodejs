<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>
    <div class="container">
        <div class="card">
            <div class="card-header">
                <h1>Cadastrar ídolo</h1>
            </div>
            <div class="card-body">
                <form action="/idolos/cadastrar" method="POST">
                    <label for="nome">Nome do ídolo:</label>
                    <input type="text" id="nome" name="nome" placeholder="Insira o nome do ídolo" class="form-control" required>

                    <label for="apelido">Apelido do ídolo:</label>
                    <input type="text" id="apelido" name="apelido" placeholder="Insira o apelido do ídolo" class="form-control" required>

                    <label for="nascimento">Nascimento do ídolo:</label>
                    <input type="text" id="nascimento" name="nascimento" placeholder="Insira o nascimento do ídolo" class="form-control" required>

                    <label for="jogos">Jogos do ídolo:</label>
                    <input type="text" id="jogos" name="jogos" placeholder="Insira os jogos do ídolo" class="form-control" required>
                    <br>
                    <button type="submit" class="btn btn-success">Cadastrar</button>
                    <button type="reset" class="btn btn-danger">Limpar</button>
                </form>
                <hr>
            </div>
        </div>
    </div>
    <br>
    <div class="container">
        <div class="card">
            <div class="card-header">
                <h1>Ídolos</h1>
            </div>
            <div class="card-body">
                <table>
                    <thead>
                        <tr>
                            <th></th>
                            <th>Nome:</th>
                            <th>Apelido:</th>
                            <th>Nascimento:</th>
                            <th>Jogos pelo Corinthians:</th>
                            <th style="text-align: center;" colspan="2">Ações:</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% idolos.forEach(idolo => { %>
                        <tr>
                            <td><img src="imgs/avatar.png" alt="<%= idolo.nome %>" width="50px"></td>
                            <td><%= idolo.nome %></td>
                            <td><%= idolo.apelido %></td>
                            <td><%= idolo.nascimento %></td>
                            <td><%= idolo.jogos %></td>
                            <td>
                                <a class="btn btn-warning" href="/idolos/editar/<%= idolo.id %>">Editar</a>
                            </td>
                            <td>
                                <a class="btn btn-danger" href="/idolos/excluir/<%= idolo.id %>" onclick="return confirm('Deseja mesmo excluir o idolo <%= idolo.nome %>')">Excluir</a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<%- include ('partials/footer.ejs') %>
