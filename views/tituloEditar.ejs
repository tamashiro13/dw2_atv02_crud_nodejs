<%- include ('partials/header.ejs')%>
<%- include ('partials/navbar.ejs')%>

<div class="container">
    <div class="card">
        <div class="card-header">
            Editar título
        </div>
        <div class="card-body">
            <form action="/titulos/alterar" method="post">
                <label for="nome">Nome do título</label>
                <input type="text" name="nome" id="nome" class="form-control" required value="<%= titulo.nome %>">

                <label for="temporada">Temporada do título</label>
                <input type="text" name="temporada" id="temporada" class="form-control" required value="<%= titulo.temporada %>">

                <input type="hidden" name="id" id="id" value="<%= titulo.id %>">
                <br>
                <button type="submit" class="btn btn-warning" onclick="return confirm ('Deseja mesmo alterar o título <%= titulo.nome %>')">Alterar</button>
                <a href="/titulos">
                    <button type="button" class="btn btn-danger">Cancelar</button>
                </a>
            </form>
        </div>
    </div>
</div>

<%- include ('partials/footer.ejs') %>